# Copie ce fichier en ".env" (sans ".example") et remplis les valeurs.
# Ne commite JAMAIS le fichier ".env" lui-même sur GitHub (voir .gitignore).

GEMINI_API_KEY=ta_cle_gemini_ici
APP_SECRET_KEY=une_chaine_aleatoire_longue_et_unique
BOOTSTRAP_ADMIN_EMAIL=admin@cie.ci
BOOTSTRAP_ADMIN_PASSWORD=UnMotDePasseFort123!

# Optionnel — désactive l'écran de connexion pour les tests locaux :
# DISABLE_LOGIN=true

# Optionnel — connexion à une base de données externe (Import de données) :
# EXTERNAL_DB_TYPE=postgresql
# EXTERNAL_DB_HOST=serveur.cie.ci
# EXTERNAL_DB_PORT=5432
# EXTERNAL_DB_NAME=cie_analytics
# EXTERNAL_DB_USER=utilisateur
